<resources>
    <style name="Theme.Ember" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ember_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Home shows the wallpaper through a transparent window. -->
    <style name="Theme.Ember.Home">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
