<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- See every launchable app (a launcher has to). Play accepts this for launchers. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Wi-Fi, mobile data and VPN icons in the status rail. Granted at install, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The glowing notification pill over other apps. The user turns it on in Android settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Uninstall from the app drawer; Android always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The lock-screen light: keep the screen on while it glows, and let the proximity sensor switch it off in a pocket. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wallpapers from your photos: read them (on the phone only) and set the wallpaper. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Where a wallpaper photo was taken (Android hides photos' GPS without it); read on the phone, named by Android's geocoder. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Smart Stack cards, each asked for only when that card is switched on:
         internet for the weather card (Open-Meteo) and nothing else; approximate location for its forecast (or pick a city);
         contacts for starred people; calendar for Up next. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Screen time card and limits (usage access is given in Android's settings), and its gentle nudges. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fingerprint, face or screen lock before showing hidden apps. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Android 14+: lets the light wake the screen when a notification arrives. -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <application
        android:name=".EmberApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Ember">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ember.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:taskAffinity="com.harsharede.ember.settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LightActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.harsharede.ember.light"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Ember.Light" />

        <!-- Receives an AI's grouping of the user's apps, shared back from the AI app. Switched on only while Ember is
             waiting for one (see AiGroups.listenForAnswer), so it isn't in every share menu. -->
        <activity
            android:name=".AiGroupsActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.harsharede.ember.aigroups"
            android:label="Ember: apply app groups">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".EmberNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
